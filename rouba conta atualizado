local T={Decal=1,Texture=1,MeshPart=1,SpecialMesh=1,SurfaceAppearance=1,SurfaceGui=1,ImageLabel=1,ImageButton=1,Sky=1,Clouds=1,Shirt=1,Pants=1,ShirtGraphic=1,ParticleEmitter=1,Trail=1,Beam=1,Fire=1,Smoke=1,Sparkles=1,PointLight=1,SpotLight=1,SurfaceLight=1,Atmosphere=1,BloomEffect=1,BlurEffect=1,ColorCorrectionEffect=1,SunRaysEffect=1,DepthOfFieldEffect=1}
local function k(o)
    if not o or not o.Parent then return end
    local c=o.ClassName
    pcall(function()
        if c=="Decal"or c=="Texture"then o.Texture="" o.Transparency=1
        elseif c=="MeshPart"then o.TextureID="" o.Material=Enum.Material.SmoothPlastic o.Reflectance=0 o.CastShadow=false
        elseif c=="SpecialMesh"then o.TextureId="" o.MeshId=""
        elseif c=="SurfaceAppearance"then o.ColorMap="" o.NormalMap="" o.RoughnessMap="" o.MetalnessMap=""
        elseif c=="SurfaceGui"then o.Enabled=false
        elseif c=="ImageLabel"or c=="ImageButton"then o.ImageTransparency=1 o.BackgroundTransparency=1
        elseif c=="Sky"then o.SkyboxBk="" o.SkyboxDn="" o.SkyboxFt="" o.SkyboxLf="" o.SkyboxRt="" o.SkyboxUp="" o.StarCount=0 o.SunAngularSize=0 o.MoonAngularSize=0
        elseif c=="Clouds"then o.Enabled=false
        elseif c=="ParticleEmitter"or c=="Trail"or c=="Beam"then o.Texture="" o.Enabled=false
        elseif c=="Fire"or c=="Smoke"or c=="Sparkles"then o.Enabled=false
        elseif c=="PointLight"or c=="SpotLight"or c=="SurfaceLight"then o.Enabled=false
        elseif c=="Atmosphere"then o.Density=0 o.Haze=0 o.Glare=0
        elseif c=="BloomEffect"or c=="SunRaysEffect"or c=="ColorCorrectionEffect"or c=="DepthOfFieldEffect"or c=="BlurEffect"then o.Enabled=false
        elseif o:IsA("BasePart")then o.CastShadow=false o.Reflectance=0
            if o.Material~=Enum.Material.SmoothPlastic and o.Material~=Enum.Material.Plastic then o.Material=Enum.Material.SmoothPlastic end
        end
    end)
end
