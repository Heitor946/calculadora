local function voar(h,hum,destino)
    h.Anchored=true
    hum.WalkSpeed=0
    hum.JumpPower=0
    local d=(h.Position-destino).Magnitude
    local tw=t:Create(h,
        TweenInfo.new(math.max(d/150,0.08),Enum.EasingStyle.Linear),
        {CFrame=CFrame.new(destino+Vector3.new(0,3,0))})
    tw:Play()
    tw.Completed:Wait()
    h.Anchored=false
    hum.WalkSpeed=16
    hum.JumpPower=50
end

