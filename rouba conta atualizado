-- HOP
local ho=false
local vis={}
local function hop()
    if ho then return end
    ho=true
    hb.Text="..."
    task.spawn(function()
        for tn=1,3 do
            local ok=pcall(function()
                local url="https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
                local d=hs:JSONDecode(game:HttpGet(url)).data
                assert(d and #d>0,"vazio")
                local ls={}
                for _,s in ipairs(d)do
                    if s.id and s.id~=game.JobId and (s.maxPlayers-s.playing)>=3 and (s.ping or 0)<200 and not vis[s.id] then
                        table.insert(ls,{id=s.id,ping=s.ping or 999})
                    end
                end
                assert(#ls>0,"sem servidor")
                table.sort(ls,function(a,b)return a.ping<b.ping end)
                local e=ls[math.random(1,math.min(#ls,5))]
                vis[e.id]=true
                if #vis>20 then vis={} end
                local ok2=pcall(function()
                    local opt=Instance.new("TeleportOptions")
                    opt.ServerInstanceId=e.id
                    ts:TeleportAsync(game.PlaceId,{p},opt)
                end)
                if not ok2 then ts:TeleportToPlaceInstance(game.PlaceId,e.id,p) end
            end)
            if ok then task.wait(10) break end
            task.wait(2^tn)
        end
        hb.Text="HOP"
        ho=false
    end)
end
hb.MouseButton1Click:Connect(hop)

