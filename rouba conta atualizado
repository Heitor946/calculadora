-- Tenta todos os métodos possíveis para "clicar" em um objeto
local function tentarClicar(obj)
    pcall(function() if firesignal then firesignal(obj.MouseButton1Click) end end)
    pcall(function() if firesignal then firesignal(obj.MouseButton1Down) end end)
    pcall(function() if firesignal then firesignal(obj.Activated) end end)
    pcall(function() obj:Activate() end)
    pcall(function() obj.MouseButton1Click:Fire() end)
    pcall(function() obj.Activated:Fire() end)
    pcall(function() obj:Click() end) -- MÉTODO ADICIONADO: Click nativo do Roblox
    pcall(function()
        if getconnections then
            for _,c in ipairs(getconnections(obj.MouseButton1Click))do c:Fire()end
            for _,c in ipairs(getconnections(obj.Activated))do c:Fire()end
        end
    end)
    pcall(function()
        if fireclickdetector then
            local cd=obj:FindFirstChildOfClass("ClickDetector")
            if cd then fireclickdetector(cd) end
        end
    end)
end

local function clicarArmazenar()
    local guis={p:FindFirstChild("PlayerGui")}
    if gethui then
        local h=gethui()
        if h then table.insert(guis,h) end
    end
    table.insert(guis,cg)
    for _,gui in ipairs(guis)do
        if gui then
            for _,o in ipairs(gui:GetDescendants())do
                if (o:IsA("TextButton")or o:IsA("ImageButton")or o:IsA("TextLabel"))and o.Visible then
                    local txt=((o.Text or "")..(o.Name or "")):lower()
                    if (txt:find("armazenar")or txt:find("store")or txt:find("guardar"))
                       and not txt:find("comer")and not txt:find("eat")then
                        tentarClicar(o)
                        if o.Parent then tentarClicar(o.Parent) end
                        return true
                    end
                end
            end
        end
    end
    return false
end

